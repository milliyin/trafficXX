    {
      "id": 1,
      "type": "stat",
      "title": "Operations scrape up",
      "description": "1 means Prometheus can scrape operations. This is not native Service Bus queue health.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "trafficxx-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"trafficxx-operations\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "trafficxx-prometheus"
          },
          "legendFormat": "{{__name__}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
