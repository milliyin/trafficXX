FROM node:24-bookworm-slim AS frontend
WORKDIR /web
COPY clickclash-web/package*.json ./
RUN npm ci --no-fund --no-audit
COPY clickclash-web/ ./
RUN npm run build

FROM python:3.12-slim-trixie
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt requirements-clickclash.txt ./
RUN pip install --no-cache-dir -r requirements-clickclash.txt && useradd --uid 10001 --create-home app
COPY trafficxx ./trafficxx
COPY database/clickclash ./database/clickclash
COPY --from=frontend /web/dist ./clickclash-web/dist
USER app
EXPOSE 8000
CMD ["uvicorn", "trafficxx.clickclash:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--no-proxy-headers", "--limit-concurrency", "128"]
